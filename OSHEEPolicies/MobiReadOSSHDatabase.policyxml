<?xml version="1.0" encoding="UTF-8"?>
<policies>
  <policy policyType="JDBCProviders" policyName="MobiReadOSSHDatabase" policyTemplate="Oracle">
    <databaseName>FREEPDB1</databaseName>
    <databaseType>Oracle</databaseType>
    <databaseVersion></databaseVersion>
    <type4DriverClassName>oracle.jdbc.OracleDriver</type4DriverClassName>
    <type4DatasourceClassName>oracle.jdbc.pool.OracleDataSource</type4DatasourceClassName>
    <connectionUrlFormat>jdbc:oracle:thin:@//[serverName]:[portNumber]/[databaseName]</connectionUrlFormat>
    <connectionUrlFormatAttr1></connectionUrlFormatAttr1>
    <connectionUrlFormatAttr2></connectionUrlFormatAttr2>
    <connectionUrlFormatAttr3></connectionUrlFormatAttr3>
    <connectionUrlFormatAttr4></connectionUrlFormatAttr4>
    <connectionUrlFormatAttr5></connectionUrlFormatAttr5>
    <serverName>localhost</serverName>
    <portNumber>1521</portNumber>
    <jarsURL>C:\Oracle_Driver\jdbc\lib</jarsURL>
    <databaseSchemaNames>useProvidedSchemaNames</databaseSchemaNames>
    <description>Local MobiRead Oracle connection for OSSH anomaly TRUNCATE operations; OSSH credentials are supplied by ACE security identity.</description>
    <maxConnectionPoolSize>0</maxConnectionPoolSize>
    <securityIdentity>mobireadOSSHSecurityIdentity</securityIdentity>
    <environmentParms></environmentParms>
    <jdbcProviderXASupport>false</jdbcProviderXASupport>
    <useDeployedJars>false</useDeployedJars>
  </policy>
</policies>
